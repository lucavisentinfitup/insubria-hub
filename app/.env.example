# Copia in .env (o imposta nel pannello dell'hosting). Tutte le variabili sono lette all'avvio.
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://app.esempio.it
DATA_DIR=/var/data/insubria-hub

# Notifiche push (obbligatorie in produzione). Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:supporto@esempio.it

# Invio dei codici di accesso via email (obbligatorio in produzione): Brevo (API HTTPS) oppure SMTP.
# Con BREVO_API_KEY impostata si usa Brevo e le variabili SMTP_* vengono ignorate. MAIL_FROM deve essere un mittente verificato su Brevo.
BREVO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Insubria Hub <no-reply@esempio.it>"

# Ruoli: chi accede con questi domini o indirizzi è personale; gli admin sono indicati a parte
STAFF_DOMAINS=uninsubria.it
STAFF_EMAILS=
ADMIN_EMAILS=

# Assistente AI (Claude). Senza chiave l'assistente risponde che non è disponibile.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

MAX_UPLOAD_MB=50
