# Copia questo file in .env (stessa cartella di docker-compose.yml) e compila i valori.

# Indirizzo pubblico dell'app, lo stesso configurato nel tunnel Cloudflare
PUBLIC_URL=https://app.tuodominio.it
# (prima del tunnel, per provarla in rete locale: http://192.168.1.2:3210)

# Token del tunnel: Cloudflare → Zero Trust → Networks → Tunnels → crea tunnel → copia il token
CLOUDFLARE_TUNNEL_TOKEN=

# Notifiche push: le stesse chiavi usate su Render
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:infoeventiinsubria@gmail.com

# Email con il codice di accesso (Brevo)
BREVO_API_KEY=
MAIL_FROM=Insubria Hub <infoeventiinsubria@gmail.com>

# Ruoli
STAFF_DOMAINS=uninsubria.it
ADMIN_EMAILS=

# Assistente
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
